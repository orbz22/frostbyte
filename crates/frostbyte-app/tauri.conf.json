{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FrostByte",
  "version": "0.3.0",
  "identifier": "com.frostbyte.app",
  "build": {
    "frontendDist": "ui"
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FrostByte Thermal Guardian",
        "width": 580,
        "height": 760,
        "resizable": false,
        "center": true,
        "visible": true
      }
    ]
  }
}
